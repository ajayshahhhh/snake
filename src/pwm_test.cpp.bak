// PWM brightness gradient test
// Flash this instead of main.cpp to verify brightness levels work.
// Each column shows a different brightness: col 0 = dim (2), col 7 = full (15).
// If PWM works you should see a clear left-to-right brightness ramp.
// Restore main.cpp when done testing.

#include <Arduino.h>
#include "led_driver.h"

static byte pat[8][8];

void setup() {
  ledInit();

  // Build a brightness gradient: col 0 = brightness 2, col 7 = brightness 15
  for (int row = 0; row < 8; row++) {
    for (int col = 0; col < 8; col++) {
      pat[row][col] = 2 + col * 2;  // 2, 4, 6, 8, 10, 12, 14, 16 → clamped to 15
      if (pat[row][col] > 15) pat[row][col] = 15;
    }
  }
}

void loop() {
  ledDisplay(pat);
}
